#!/bin/bash

if [[ -f "/config/sabnzbd.ini" ]]; then
    CONFIGURED_HOST=$(grep -Poz '(?s)\[misc\].*?\nhost\s*=\K(\N+)' /config/sabnzbd.ini 2>/dev/null | tr -d '\0" ')
    WEBUI_PORT=$(grep -Poz '(?s)\[misc\].*?\port\s*=\K(\N+)' /config/sabnzbd.ini 2>/dev/null | tr -d '\0" ')
    HTTPS_ENABLED=$(grep -Poz '(?s)\[misc\].*?\nenable_https\s*=\K(\N+)' /config/sabnzbd.ini 2>/dev/null | tr -d '\0" ')
    if grep -Poz '(?s)\[misc\].*?\nhttps_port\s*=\K(\N+)' /config/sabnzbd.ini 2>/dev/null | tr -d '\0" '; then
        WEBUI_HTTPS_PORT=${WEBUI_PORT}
    else
        WEBUI_HTTPS_PORT=$(grep -Poz '(?s)\[misc\].*?\nehttps_port\s*=\K(\N+)' /config/sabnzbd.ini 2>/dev/null | tr -d '\0" ')
    fi
fi

if [[ ${HTTPS_ENABLED} == 1 ]]; then
    if curl -skL "https://${CONFIGURED_HOST:-localhost}:${WEBUI_HTTPS_PORT:-8080}/sabnzbd/api?mode=version" > /dev/null 2>&1; then
        exit 0
    else
        exit 1
    fi
else
    if curl -skL "http://${CONFIGURED_HOST:-localhost}:${WEBUI_PORT:-8080}/sabnzbd/api?mode=version" > /dev/null 2>&1; then
        exit 0
    else
        exit 1
    fi
fi
